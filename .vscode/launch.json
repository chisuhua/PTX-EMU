{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug PTX Parser Test",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/test-ptx",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/lib:${env:LD_LIBRARY_PATH}"
                },
                {
                    "name": "PTX_EMU_PATH",
                    "value": "${workspaceFolder}"
                }
            ]
        },
        {
            "name": "Debug Active File",
            "type": "cpp",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/build",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/lib:${env:LD_LIBRARY_PATH}"
                },
                {
                    "name": "PTX_EMU_PATH",
                    "value": "${workspaceFolder}"
                }
            ],
            "preLaunchTask": "build",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug Active File without Build",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/build",
            "terminal": "integrated",
            "sourceFileMap": {
                "/home/dev/workspace/PTX-EMU": "${workspaceFolder}"
            },
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/lib:${env:LD_LIBRARY_PATH}"
                },
                {
                    "name": "PTX_EMU_PATH",
                    "value": "${workspaceFolder}"
                }
            ]
        },
