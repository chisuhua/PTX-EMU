// Test: 4-Path Multiway Branch
// Simulates switch-case with 4 paths
// Expected: All paths reconverge at merge_point

.version 8.0
.target sm_80
.address_size 64

.visible .entry test_multipath_4ways() {
.reg .pred %p<2>;
.reg .b32 %r<3>;

// PC=0: Load thread ID
mov.u32 %r1, %tid.x;

// PC=1-2: Path selection (tier 1)
setp.lt.u32 %p1, %r1, 8;
@%p1 bra $L_path_low;

// PC=3-4: High path check (tier 2)
setp.lt.u32 %p2, %r1, 24;
@%p2 bra $L_path_mid_high;

// PC=5-6: Path 4 (lanes 24-31)
add.u32 %r2, %r1, 4000;
bra.uni $L_merge_point;

// PC=7: Path 3 label (lanes 16-23)
L_path_mid_high:
add.u32 %r2, %r1, 3000;
bra.uni $L_merge_point;

// PC=8: Path low check (tier 2)
L_path_low:
// PC=9-10: Path 2 check
setp.lt.u32 %p2, %r1, 16;
@%p2 bra $L_path_mid_low;

// PC=11: Path 1 (lanes 8-15)
add.u32 %r2, %r1, 2000;
bra.uni $L_merge_point;

// PC=12: Path 0 label (lanes 0-7)
L_path_mid_low:
add.u32 %r2, %r1, 1000;
// Fall through to merge

// PC=13: Merge point (all 4 paths converge)
L_merge_point:
st.shared.u32 [%shared0], %r2;
bar.sync 0;
ret;
}
