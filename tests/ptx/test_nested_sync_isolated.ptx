// Test 3 standalone: 16-thread nested sync, isolated memory
// Same kernel as test_syncthreads but with explicit memory clearing

.version 9.0
.target sm_100
.address_size 64

.visible .entry test_nested_sync_standalone() {
.reg .pred %p<1>;
.reg .b32 %r<5>;
.reg .b64 %rd<2>;

.shared .align 4 .b8 data_a[64];
.shared .align 4 .b8 data_b[64];

mov.u32 %r1, %tid.x;
shl.b32 %r4, %r1, 2;
mov.u32 %r5, data_a;
add.s32 %r2, %r5, %r4;

// Initialize data_a with tid
st.shared.u32 [%r2], %r1;
bar.sync 0;

// Divergent write: data_b[tid] = data_a[tid] + data_a[(tid+1)%16]
setp.gt.u32 %p1, %r1, 15;
mov.u32 %r3, data_b;
add.s32 %r3, %r3, %r4;
@%p1 bra $L__skip;

ld.shared.u32 %r4, [%r2];
add.s32 %r9, %r4, 4;
and.b32 %r10, %r9, 60;
add.s32 %r12, %r5, %r10;
ld.shared.u32 %r13, [%r12];
add.s32 %r14, %r13, %r4;
st.shared.u32 [%r3], %r14;

$L__skip:
bar.sync 0;

// Read data_b back for verification
ld.shared.u32 %r4, [%r3];
ret;
}
